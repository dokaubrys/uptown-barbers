---
// Line-art straight razor: the brand's signature illustration.
// Draws itself on load, then a glint runs along the edge.
---

<svg class="razor" viewBox="0 0 800 260" fill="none" role="img" aria-hidden="true">
  <defs>
    <linearGradient id="glint" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#ef3b2d" stop-opacity="0" />
      <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.95" />
      <stop offset="1" stop-color="#ef3b2d" stop-opacity="0" />
    </linearGradient>
    <clipPath id="blade-clip">
      <path d="M300 116 L340 110 L700 96 Q762 94 770 122 Q774 154 740 160 L340 156 L300 150 Z" />
    </clipPath>
  </defs>

  <!-- handle / scales -->
  <path class="razor__draw" d="M332 122 L66 156 Q30 161 32 178 Q35 196 68 192 L332 148 Z" stroke="currentColor" stroke-width="1.5" />
  <path class="razor__draw razor__dim" d="M310 128 L76 160 Q54 164 55 176 Q57 186 76 184 L310 144" stroke="currentColor" stroke-width="1" />
  <circle class="razor__draw" cx="74" cy="176" r="5" stroke="currentColor" stroke-width="1.5" />

  <!-- blade -->
  <path class="razor__draw" d="M300 116 L340 110 L700 96 Q762 94 770 122 Q774 154 740 160 L340 156 L300 150 Z" stroke="currentColor" stroke-width="1.5" />
  <path class="razor__draw razor__dim" d="M352 142 L738 146" stroke="currentColor" stroke-width="1" />
  <path class="razor__draw razor__edge" d="M340 156 L740 160" stroke="#ef3b2d" stroke-width="2.5" />

  <!-- pivot -->
  <circle class="razor__draw" cx="318" cy="134" r="9" stroke="currentColor" stroke-width="1.5" />
  <circle cx="318" cy="134" r="2.5" fill="#ef3b2d" />

  <!-- etching -->
  <text x="420" y="132" class="razor__etch">UPTOWN · VILNIUS · KAUNAS</text>

  <!-- glint -->
  <g clip-path="url(#blade-clip)">
    <rect class="razor__glint" x="-120" y="80" width="120" height="100" fill="url(#glint)" />
  </g>
</svg>

<style>
  .razor { width: 100%; height: auto; color: var(--bone); overflow: visible; }
  .razor__dim { opacity: 0.35; }
  .razor__etch {
    font-family: var(--f-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.4em;
    fill: var(--steel);
  }
  .razor__glint { opacity: 0; mix-blend-mode: screen; }

  @media (prefers-reduced-motion: no-preference) {
    .razor__draw {
      stroke-dasharray: 1200;
      stroke-dashoffset: 1200;
      animation: razor-draw 1.6s var(--ease-out) forwards;
    }
    .razor__edge { animation-delay: 0.6s; }
    .razor__glint { animation: razor-glint 1.4s 1.5s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  }
  @keyframes razor-draw { to { stroke-dashoffset: 0; } }
  @keyframes razor-glint {
    0% { opacity: 0; transform: translateX(300px) skewX(-20deg); }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { opacity: 0; transform: translateX(900px) skewX(-20deg); }
  }
</style>
