---
import Logo from './Logo.astro';
import type { Lang } from '../data/site';
import { strings, routes } from '../i18n/strings';

interface Props { lang: Lang; altPath: string; page: 'home' | 'booking' }
const { lang, altPath, page } = Astro.props;
const t = strings[lang];
const r = routes[lang];
const home = page === 'home' ? '' : r.home;
const links = [
  { href: `${home}#paslaugos`, label: t.nav.services },
  { href: `${home}#salonai`, label: t.nav.locations },
  { href: `${home}#akademija`, label: t.nav.academy },
  { href: `${home}#kontaktai`, label: t.nav.contact },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a href={r.home} class="header__logo" aria-label="Uptown Barbers">
      <Logo />
    </a>

    <nav class="header__nav" aria-label={lang === 'lt' ? 'Pagrindinė navigacija' : 'Main navigation'}>
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__lang" href={altPath} hreflang={lang === 'lt' ? 'en' : 'lt'} lang={lang === 'lt' ? 'en' : 'lt'}>
        <span class="visually-hidden">{t.langSwitch}</span>
        <span aria-hidden="true">{t.langSwitchShort}</span>
      </a>
      {page !== 'booking' && (
        <a class="btn btn--sm header__book" href={r.booking} data-book>{t.book}</a>
      )}
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden" data-label-open>{t.menu}</span>
        <span class="visually-hidden" data-label-close hidden>{t.close}</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <nav class="wrap" aria-label={lang === 'lt' ? 'Mobili navigacija' : 'Mobile navigation'}>
      <ol role="list" class="mobile-menu__list">
        {links.map((l) => (
          <li>
            <a href={l.href} data-menu-link>
              <span class="display">{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="btn mobile-menu__book" href={r.booking} data-book data-menu-link>{t.bookLong}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
      toggle.querySelector('[data-label-open]')!.toggleAttribute('hidden', open);
      toggle.querySelector('[data-label-close]')!.toggleAttribute('hidden', !open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
    });
    matchMedia('(min-width: 900px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--line);
  }
  /* Blur lives on a pseudo-element: backdrop-filter on .header itself would
     become the containing block for the fixed mobile menu and clip it. */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(11 11 12 / 0.9);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    height: var(--header-h);
  }
  .header__logo { display: inline-flex; min-height: 44px; align-items: center; }
  .header__nav { display: none; }
  .header__nav ul { display: flex; gap: clamp(1.25rem, 2.5vw, 2.5rem); }
  .header__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color var(--dur-fast);
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    height: 1px;
    background: var(--edge);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }
  .header__nav a:hover { color: var(--text); }
  .header__nav a:hover::after { transform: scaleX(1); }
  .header__actions { display: flex; align-items: center; gap: var(--s-2); }
  .header__lang {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    font-size: var(--t-xs);
    font-weight: 800;
    letter-spacing: 0.14em;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--dur-fast), color var(--dur-fast);
  }
  .header__lang:hover { box-shadow: inset 0 0 0 1px var(--edge); color: var(--edge); }
  .header__book { display: none; }

  .header__burger {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
  }
  .burger { position: relative; width: 22px; height: 10px; }
  .burger span {
    position: absolute; left: 0; right: 0;
    height: 2px; background: currentColor;
    transition: transform var(--dur) var(--ease-out), top var(--dur) var(--ease-out);
  }
  .burger span:first-child { top: 0; }
  .burger span:last-child { top: 8px; width: 60%; left: auto; }
  [aria-expanded='true'] .burger span:first-child { top: 4px; transform: rotate(45deg); }
  [aria-expanded='true'] .burger span:last-child { top: 4px; width: 100%; transform: rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: var(--z-menu);
    background: var(--ink);
    overflow-y: auto;
    padding-block: var(--s-4) calc(var(--s-4) + env(safe-area-inset-bottom));
  }
  .mobile-menu__list li { border-bottom: 1px solid var(--line); }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding-block: var(--s-3);
  }
  .mobile-menu__list .display { font-size: clamp(2.5rem, 12vw, 4rem); }
  .mobile-menu__book { width: 100%; margin-top: var(--s-4); }

  @media (min-width: 560px) {
    .header__book { display: inline-flex; }
  }
  @media (min-width: 900px) {
    .header__nav { display: block; }
    .header__burger { display: none; }
  }
</style>
