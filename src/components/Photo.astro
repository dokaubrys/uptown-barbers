---
// Photo frame. With `src` it renders an optimised responsive image
// (Astro builds WebP at several widths). Without it, a styled placeholder.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  label?: string;
  ratio?: string;
  position?: string;
  sizes?: string;
  class?: string;
}
const { src, alt, label, ratio = '4 / 5', position = 'center', sizes = '(min-width: 768px) 50vw, 100vw', class: cls } = Astro.props;
---

<figure class:list={['photo', cls]} style={`aspect-ratio:${ratio}`}>
  {src ? (
    <Image
      src={src}
      alt={alt}
      width={1600}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      format="webp"
      quality={72}
      loading="lazy"
      decoding="async"
      style={`object-position:${position}`}
    />
  ) : (
    <div class="photo__ph" role="img" aria-label={alt}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 7h3l2-3h8l2 3h3v13H3z"/><circle cx="12" cy="13" r="4"/></svg>
    </div>
  )}
  {label && <figcaption class="photo__cap">{label}</figcaption>}
</figure>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--ink-3);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.06) brightness(0.92);
    transform: scale(1.01);
    transition: filter 600ms var(--ease-out), transform 1200ms var(--ease-out);
  }
  .photo:hover img { filter: grayscale(0) contrast(1.04) brightness(1); transform: scale(1.04); }
  .photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(to top, rgb(11 11 12 / 0.7), transparent);
    pointer-events: none;
  }
  .photo__cap {
    position: absolute;
    left: var(--s-2);
    bottom: var(--s-2);
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bone);
  }
  .photo__cap::before {
    content: '';
    width: 18px;
    height: 5px;
    background: var(--edge);
    clip-path: polygon(0 40%, 80% 0, 100% 50%, 80% 100%, 0 60%);
  }
  .photo__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    color: var(--steel);
    background:
      repeating-linear-gradient(135deg, rgb(237 232 223 / 0.035) 0 1px, transparent 1px 14px),
      radial-gradient(120% 80% at 30% 20%, #26272b, var(--ink-2) 70%);
  }
  .photo__ph svg { width: 28px; height: 28px; }
</style>
