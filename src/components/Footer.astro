---
import Logo from './Logo.astro';
import { contact, locations, mapsUrl } from '../data/site';
import type { Lang } from '../data/site';
import { strings } from '../i18n/strings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const year = new Date().getFullYear();
---

<footer class="footer" id="kontaktai">
  <div class="wrap">
    <div class="footer__top">
      <Logo size="lg" />
    </div>
    <div class="rule"></div>
    <div class="footer__grid">
      <div>
        <h2 class="footer__h">{t.footer.contact}</h2>
        <ul role="list" class="footer__list">
          <li><a class="link" href={`tel:${contact.phone}`}>{contact.phoneDisplay}</a></li>
          <li><a class="link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__h">{t.nav.locations}</h2>
        <ul role="list" class="footer__list">
          {locations.map((l) => (
            <li>
              <a class="link" href={mapsUrl(l.street, l.city.lt)} target="_blank" rel="noopener">
                {l.street}, {l.city[lang]}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="footer__h">{t.footer.follow}</h2>
        <ul role="list" class="footer__social">
          <li>
            <a href={contact.instagram} target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
            </a>
          </li>
          <li>
            <a href={contact.facebook} target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="footer__base">
      <p>© {year} {t.footer.rights}</p>
      <a class="link" href="https://www.uptownbarbershop.lt/home-1">{t.footer.privacy}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: var(--s-7) var(--s-4);
    background: var(--ink);
  }
  .footer__top { margin-bottom: var(--s-5); }
  .footer__grid {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-5);
  }
  .footer__h {
    font-family: var(--f-body);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: var(--s-2);
  }
  .footer__list { display: grid; gap: 0; }
  .footer__social { display: flex; gap: var(--s-1); }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow var(--dur-fast), color var(--dur-fast);
  }
  .footer__social a:hover { color: var(--edge); box-shadow: inset 0 0 0 1px var(--edge); }
  .footer__social svg { width: 20px; height: 20px; }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--t-xs);
    color: var(--text-dim);
  }
  @media (min-width: 768px) {
    .footer__grid { grid-template-columns: 1fr 1.4fr 1fr; }
  }
</style>
